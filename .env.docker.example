# ==========================================
# Tesachor Docker & Production Environment Reference
# ==========================================

# Application Settings
APP_NAME=Tesachor
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://your-domain.com

# Admin Security
ADMIN_LOGIN_PATH=tesachor-portal-hq

# Locale Settings
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Logging (Docker outputs directly to stdout/stderr via docker logs)
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database (PostgreSQL / Supabase / MySQL)
# Example for Supabase or Managed PostgreSQL:
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_secure_password
# (Or if using local docker-compose MySQL: DB_CONNECTION=mysql, DB_HOST=db, DB_PORT=3306)

# Session & Cache (Stored in Redis or Database in production)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# Supabase S3 File Storage (Avatars, Destinations, Provinces)
FILESYSTEM_DISK=supabase_destination
SUPABASE_S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_KEY=your_supabase_s3_key
SUPABASE_S3_SECRET=your_supabase_s3_secret

SUPABASE_AVATAR_BUCKET=avatar
SUPABASE_AVATAR_PUBLIC_URL=https://your-project.supabase.co/storage/v1/object/public/avatar
SUPABASE_DESTINATION_BUCKET=destinations
SUPABASE_DESTINATION_PUBLIC_URL=https://your-project.supabase.co/storage/v1/object/public/destinations
SUPABASE_PROVINCE_BUCKET=provinces
SUPABASE_PROVINCE_PUBLIC_URL=https://your-project.supabase.co/storage/v1/object/public/provinces

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Docker Container Automation
AUTORUN_MIGRATIONS=true
